{
  "folders": [
    "~/Documents"
  ],
  "excludeFolders": [
    "node_modules",
    ".git",
    "Library",
    ".Trash",
    "dist",
    "build",
    "venv",
    "__pycache__",
    "site-packages",
    "Pods",
    "DerivedData",
    "target",
    "out",
    "coverage",
    "~/Desktop/RAGtest/data",
    "~/Desktop/RAGtest/electron"
  ],
  "sensitivePatterns": [
    "password",
    "passwd",
    "secret",
    "credential",
    "token",
    "apikey",
    "api_key",
    "private key",
    "id_rsa",
    "wallet",
    "seed phrase",
    "recovery",
    "2fa",
    "otp",
    ".env",
    ".pem",
    ".key",
    ".p12",
    ".kdbx",
    "keychain",
    "passport",
    "bank",
    "tax",
    "aadhar",
    "aadhaar",
    "pan card"
  ],
  "model": "nvidia/nemotron-3.5-super-vl:free",
  "allowedOrigins": [],
  "maxFileMB": 60,
  "skipExtensions": [
    "meta",
    "prefab",
    "sqlite",
    "sqlite-wal",
    "sqlite-shm",
    "jsonlz4",
    "final",
    "log",
    "pyc",
    "dll",
    "so",
    "dylib",
    "lock",
    "ds_store",
    "asset",
    "unity",
    "fbx",
    "mat",
    "cache",
    "tmp",
    "db",
    "bin",
    "exe",
    "dmg",
    "pkg",
    "iso",
    "zip",
    "7z",
    "rar",
    "tar",
    "gz",
    "mp3",
    "wav",
    "mp4",
    "mov",
    "mkv",
    "ttf",
    "otf",
    "woff",
    "woff2",
    "class",
    "o",
    "obj",
    "pdb",
    "psd",
    "ai",
    "blend"
  ],
  "openrouterModel": "nvidia/nemotron-3.5-super-vl:free",
  "maxOutputTokens": 1500,
  "maxSteps": 10,
  "fullPc": false,
  "aiLevel": 3,
  "smartApproved": false,
  "aiMode": "offline",
  "ocr": true,
  "maxSheetMB": 10,
  "scanIntervalMin": 15,
  "provider": "openrouter"
}