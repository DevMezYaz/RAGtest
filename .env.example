# Cheapest option: OpenRouter, defaults to Claude Haiku (override with OPENROUTER_MODEL)
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Or use the Claude API directly (ignored while OPENROUTER_API_KEY is set)
# ANTHROPIC_API_KEY=sk-ant-...
# optional: require this bearer token on every /v1 call (needed once exposed beyond localhost)
# SLEEPY_API_KEY=
# PORT=4477
